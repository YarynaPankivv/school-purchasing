{
  "name": "2026-quitcode-06-project-template",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "spec:validate": "openspec validate --all --strict",
    "spec:check": "node scripts/check-spec.mjs",
    "ac:coverage": "node scripts/check-ac-coverage.mjs",
    "db:types": "supabase gen types typescript --linked > src/lib/supabase/database.types.ts",
    "e2e:seed": "node --env-file=.env.local scripts/e2e-seed.mjs",
    "users:demo": "node --env-file=.env.local scripts/create-demo-users.mjs",
    "check:design": "node scripts/check-design-tokens.mjs",
    "check:boundary": "node scripts/check-server-boundary.mjs",
    "shots": "node --env-file=.env.local scripts/capture-screenshots.mjs",
    "check:actions": "node scripts/check-server-actions.mjs",
    "smoke": "node scripts/smoke.mjs",
    "gates": "npm run lint && npm run typecheck && fallow audit --base origin/main",
    "test:coverage": "vitest run --config vitest.coverage.config.mts --coverage",
    "coverage:summary": "node scripts/coverage-summary.mjs",
    "mutation:ts": "stryker run",
    "mutation:sql": "node scripts/mutation-check.mjs",
    "test:e2e": "playwright test",
    "uat": "node scripts/uat/run.mjs",
    "uat:nc": "node scripts/uat/run.mjs --negative-controls",
    "uat:review": "node scripts/uat/review.mjs && node scripts/uat/report.mjs",
    "accounts:zip": "node scripts/zip-accounts.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fission-ai/openspec": "1.14.1",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/eslint-plugin": "1.6.27",
    "@zip.js/zip.js": "2.24.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-playwright": "2.12.1",
    "fallow": "3.35.0",
    "supabase": "2.120.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "24.x"
  }
}
